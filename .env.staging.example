# Staging stack — copy to .env.staging.
#
# Same variable names as .env, different values, so there is no translation
# table to get wrong. Read with:
#   docker compose --env-file .env.staging -f docker-compose.staging.yml up -d
#
# Keep these ports distinct from production's 8084/8083.

EDGE_PORT=8086
TRACKER_PORT=8087
TRACKER_PATH=/
