# Upstreams are resolved per request: nginx otherwise caches the container IP at
# startup, and recreating `web` (every deploy) leaves the edge answering 502
# until it is restarted.
resolver 127.0.0.11 valid=10s ipv6=off;

# Web frontend (default) — serves the React/Vite SPA
server {
  listen 80 default_server;
  server_name _ tilawa.quran.us.kg staging-tilawa.quran.us.kg;

  location / {
    set $web_upstream http://web:80;
    proxy_pass $web_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /health {
    return 200 'ok';
    add_header Content-Type text/plain;
  }
}

# WebTorrent tracker — WebSocket + HTTP
server {
  listen 80;
  server_name tracker.quran.us.kg;

  location / {
    set $tracker_upstream http://tracker:${TRACKER_PORT};
    proxy_pass $tracker_upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location /stats {
    set $tracker_stats http://tracker:${TRACKER_PORT}/stats;
    proxy_pass $tracker_stats;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

# Seeder admin UI
server {
  listen 80;
  server_name admin.tilawa.quran.us.kg;

  location / {
    set $seeder_upstream http://seeder:8085;
    proxy_pass $seeder_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
  }
}
