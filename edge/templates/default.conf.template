# Upstreams are resolved per request: nginx otherwise caches the container IP at
# startup, and recreating `web` (every deploy) leaves the edge answering 502
# until it is restarted.
resolver 127.0.0.11 valid=10s ipv6=off;

# Web frontend (default) — serves the React/Vite SPA
server {
  listen 80 default_server;
  server_name _ tilawah.cc;

  location / {
    set $web_upstream http://web:80;
    proxy_pass $web_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /health {
    return 200 'ok';
    add_header Content-Type text/plain;
  }
}

# Preview channel — the same bundle built from the `staging` worktree. Same
# vhost shape as the site, so what is tested is what ships; the container has no
# published port, only this name.
server {
  listen 80;
  server_name staging.tilawah.cc;

  # The preview channel runs the same bundle as the site, so nothing in the build can
  # tell them apart: the prerendered pages carry a canonical pointing at tilawah.cc,
  # which is a hint a crawler is free to ignore, and a link shared to this host would
  # be indexed as a second copy. The header is the authoritative signal and covers
  # every response, HTML or asset. It lives on the vhost because the edge is the only
  # layer that knows which host is answering.
  add_header X-Robots-Tag "noindex, nofollow" always;

  location / {
    set $web_staging_upstream http://web-staging:80;
    proxy_pass $web_staging_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

# WebTorrent tracker — WebSocket + HTTP
server {
  listen 80;
  server_name tracker.tilawah.cc;

  location / {
    set $tracker_upstream http://tracker:${TRACKER_PORT};
    proxy_pass $tracker_upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location /stats {
    set $tracker_stats http://tracker:${TRACKER_PORT}/stats;
    proxy_pass $tracker_stats;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

# Seeder admin UI.
# NOTE: not routed by the tilawah.cc tunnel. Add `seeder.tilawah.cc` to
# ~/cloudflared-tilawah/config.yml and its DNS if this door should be public;
# otherwise reach the seeder over loopback (127.0.0.1:8085).
server {
  listen 80;
  server_name seeder.tilawah.cc;

  location / {
    set $seeder_upstream http://seeder:8085;
    proxy_pass $seeder_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
  }
}
