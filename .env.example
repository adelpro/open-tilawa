# Edge
EDGE_PORT=8084

# Tracker
TRACKER_PORT=8083
TRACKER_PATH=/

# Staging does not live here: it has its own project and its own file.
# Copy .env.staging.example to .env.staging and read it with
#   docker compose --env-file .env.staging -f docker-compose.staging.yml up -d

# Seeder
MAX_CONCURRENT_DOWNLOADS=3
MAGNETS_URL=https://tilawa.quran.us.kg/api/magnet-uris
DOWNLOAD_PATH=/data/downloads

# Itqan CMS API key (seeder only; never shipped to the web app)
ITQAN_API_KEY=

# TURN (coturn) - fill when setting up
TURN_REALM=turn.quran.us.kg
TURN_USERNAME=
TURN_PASSWORD=
TURN_EXTERNAL_IP=
