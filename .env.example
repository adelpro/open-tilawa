# Edge
EDGE_PORT=8084

# Tracker
TRACKER_PORT=8083
TRACKER_PATH=/

# One environment, plus a preview channel for the web shell.
# `web-staging` builds `STAGING_CONTEXT` (a `staging` git worktree) and serves
# it at staging.tilawah.cc. It has no volumes of its own and uses the prod
# catalogue and relay, so it is a UI canary, not a data sandbox. See
# docs/RELEASING.md.
STAGING_CONTEXT=../open-tilawa-staging

# The admin API answers only these origins; an unlisted one is refused (the
# CORS callback errors, which the API reports as a 500, not a blocked read).
# Keep it one line: a second ADMIN_CORS_ORIGIN wins silently.
ADMIN_CORS_ORIGIN=https://console.tilawah.cc,https://tilawah.cc,https://staging.tilawah.cc

# Seeder
MAX_CONCURRENT_DOWNLOADS=3
# There is no magnet-list endpoint on the admin API (/api/public exposes only
# reciters), so a URL here can only fail and fall back to local `.torrent` files.
# Leave it unset unless a real endpoint is added.
MAGNETS_URL=
DOWNLOAD_PATH=/data/downloads

# Itqan CMS API key (seeder only; never shipped to the web app)
ITQAN_API_KEY=

# TURN (coturn) - fill when setting up
TURN_REALM=turn.tilawah.cc
TURN_USERNAME=
TURN_PASSWORD=
TURN_EXTERNAL_IP=
