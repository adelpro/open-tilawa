# Edge
EDGE_PORT=8084
# Staging stack. Separate variables on purpose: compose reads this same .env
# for both stacks, and sharing EDGE_PORT put staging on the production port.
STAGING_EDGE_PORT=8086
STAGING_TRACKER_PORT=8087

# Tracker
TRACKER_PORT=8083
TRACKER_PATH=/

# Seeder
MAX_CONCURRENT_DOWNLOADS=3
MAGNETS_URL=https://tilawa.quran.us.kg/api/magnet-uris
DOWNLOAD_PATH=/data/downloads

# Itqan CMS API key (seeder only; never shipped to the web app)
ITQAN_API_KEY=

# TURN (coturn) - fill when setting up
TURN_REALM=turn.quran.us.kg
TURN_USERNAME=
TURN_PASSWORD=
TURN_EXTERNAL_IP=
