# Edge
EDGE_PORT=8084

# Tracker
TRACKER_PORT=8083
TRACKER_PATH=/

# One environment. There is no staging stack during the alpha; see
# docs/RELEASING.md for what it would need to come back.

# Seeder
MAX_CONCURRENT_DOWNLOADS=3
# There is no magnet-list endpoint on the admin API (/api/public exposes only
# reciters), so a URL here can only fail and fall back to local `.torrent` files.
# Leave it unset unless a real endpoint is added.
MAGNETS_URL=
DOWNLOAD_PATH=/data/downloads

# Itqan CMS API key (seeder only; never shipped to the web app)
ITQAN_API_KEY=

# TURN (coturn) - fill when setting up
TURN_REALM=turn.tilawah.cc
TURN_USERNAME=
TURN_PASSWORD=
TURN_EXTERNAL_IP=
