# Standalone seeder image for deployment on new servers.
# Build: docker build -f apps/seeder/Dockerfile.standalone -t ghcr.io/adelpro/open-tilawa-seeder:latest .

FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache python3

# Copy seeder files
COPY apps/seeder/seed-all.mjs ./seed-all.mjs
COPY apps/seeder/admin ./admin

# Install webtorrent
RUN npm install -g webtorrent

EXPOSE 8085
ENV ADMIN_PORT=8085
ENV ADMIN_USER=admin
ENV ADMIN_PASS=change-me-in-prod

CMD ["node", "seed-all.mjs"]
