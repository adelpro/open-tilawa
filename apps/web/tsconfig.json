{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@components/*": [
        "src/components/*"
      ],
      "@types/*": [
        "src/types/*"
      ],
      "@assets/*": [
        "src/assets/*"
      ],
      "@utils/*": [
        "src/utils/*"
      ],
      "@svgs/*": [
        "src/svgs/*"
      ],
      "@hooks/*": [
        "src/hooks/*"
      ],
      "next/image": [
        "src/shims/image.tsx"
      ],
      "next/link": [
        "src/shims/link.tsx"
      ],
      "next/navigation": [
        "src/shims/navigation.ts"
      ],
      "next/dynamic": [
        "src/shims/dynamic.tsx"
      ],
      "next/script": [
        "src/shims/script.tsx"
      ],
      "next/font/google": [
        "src/shims/font.ts"
      ]
    }
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}