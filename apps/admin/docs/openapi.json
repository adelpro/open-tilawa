  "info": {
    "title": "Tilawa Admin API",
    "description": "",
    "version": "1.20.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "UpdateUserDTO": {
        "type": "object",
        "properties": {}
      },
      "SigninDTO": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "johndoe@email.com",
            "description": "The email of the person"
          },
          "password": {
            "type": "string",
            "example": "Password123",
            "description": "The password of the person"
          }
        },
        "required": ["email", "password"]
      },
      "signinUserDTO": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/SigninDTO"
          }
        },
        "required": ["user"]
      },
      "AuthenticatedUserResponseDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "object",
            "example": "42",
            "description": "The unique identifier for the user."
          },
          "email": {
            "type": "string",
            "example": "example@example.com",
            "description": "The email address of the user."
          },
          "name": {
            "type": "string",
            "example": "John Doe",
            "description": "The name of the user."
          },
          "isActivated": {
            "type": "boolean",
            "example": "true",
            "description": "The provider used for authentication."
          },
          "isTwoFAEnabled": {
            "type": "boolean",
            "example": "true",
            "description": "The provider used for authentication."
          },
          "provider": {
            "type": "string",
            "example": "local",
            "description": "The provider used for authentication."
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "isActivated",
          "isTwoFAEnabled",
          "provider"
        ]
      },
      "ErrorResponseDTO": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": "Number",
            "description": "The response status code"
          },
          "message": {
            "type": "string",
            "example": "Response message",
            "description": "The response message"
          },
          "error": {
            "type": "string",
            "example": "Response error",
            "description": "The response error"
          }
        },
        "required": ["statusCode", "message", "error"]
      },
      "SignupDTO": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "JohnDoe",
            "description": "The name of the person"
          },
          "email": {
            "type": "string",
            "example": "johndoe@email.com",
            "description": "The email of the person"
          },
          "password": {
            "type": "string",
            "example": "Password123",
            "description": "The password of the person"
          }
        },
        "required": ["name", "email", "password"]
      },
      "SignupUserDTO": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/SignupDTO"
          }
        },
        "required": ["user"]
      },
      "SendResetEmailDTO": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "johndoe@email.com"
          }
        },
